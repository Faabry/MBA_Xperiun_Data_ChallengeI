	measure 'Clientes Recorrentes' =
			
			VAR ClientesMaisDeUmPedido =
			    CALCULATETABLE(
			        VALUES(dim_customers[customer_unique_id]),
			        FILTER(
			            ADDCOLUMNS(
			                VALUES(dim_customers[customer_unique_id]),
			                "QtdPedidos", CALCULATE(DISTINCTCOUNT(fact_orders[order_id]))
			            ),
			            [QtdPedidos] > 1
			        )
			    )
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(dim_customers[customer_unique_id]),
			    dim_customers[customer_unique_id] IN ClientesMaisDeUmPedido
			)
		formatString: 0
		lineageTag: 436f49a9-e508-493a-bc12-3802efe9c2c2

	measure ClientesRecompra = ```
			
			    Var ClientesRecompra = CALCULATE(
			    DISTINCTCOUNT(fact_orders[customer_id]),
			    FILTER(
			        VALUES(fact_orders[customer_id]),
			        CALCULATE(DISTINCTCOUNT(fact_orders[order_id])) > 1
			    )
			)
			
			RETURN  DIVIDE(ClientesRecompra, DISTINCTCOUNT( fact_orders[customer_id]), 0)
			```
		lineageTag: ee25c4f4-fb73-4c44-87ee-19fb21e51289

		annotation PBI_FormatHint = {"isGeneralNumber":true}


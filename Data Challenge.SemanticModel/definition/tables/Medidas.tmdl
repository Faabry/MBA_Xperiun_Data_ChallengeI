	measure 'Clientes Acima do Ticket Médio' =
			
			
			VAR vTicketMedioGeral =
			    DIVIDE (
			        CALCULATE ( SUM ( fact_orders[payment_value] ), ALL ( fact_orders ) ),
			        CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_id] ), ALL ( fact_orders ) )
			    )
			RETURN
			
			    COUNTROWS (
			        FILTER (
			            VALUES ( fact_orders[customer_id] ),
			            CALCULATE ( SUM ( fact_orders[payment_value] ) ) > vTicketMedioGeral
			        )
			    )
		formatString: #,0
		lineageTag: f9713f9d-e082-49f2-ab21-3489a018e6d9

